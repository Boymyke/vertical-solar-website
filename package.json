{
  "name": "vertical-solar",
  "version": "1.0.0",
  "private": true,
  "description": "Vertical Solar Nigeria — website, CRM and field-operations platform on Cloudflare Workers",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply vertical-solar-db --local",
    "db:migrate": "wrangler d1 migrations apply vertical-solar-db --remote",
    "deploy": "node scripts/build.mjs && wrangler deploy"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/lexend": "^5.3.0",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "chart.js": "^4.6.1",
    "html2pdf.js": "^0.10.3",
    "leaflet": "1.9",
    "remixicon": "^4.9.1",
    "wrangler": "^4.40.0"
  }
}
